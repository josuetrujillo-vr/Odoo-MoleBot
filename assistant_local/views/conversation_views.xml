<odoo>
    <record id="assistant_conversation_list" model="ir.ui.view">
        <field name="name">assistant.conversation.list</field>
        <field name="model">assistant.conversation</field>
        <field name="arch" type="xml">
            <list><field name="name"/><field name="company_id" groups="base.group_multi_company"/></list>
        </field>
    </record>
    <record id="assistant_conversation_form" model="ir.ui.view">
        <field name="name">assistant.conversation.form</field>
        <field name="model">assistant.conversation</field>
        <field name="arch" type="xml">
            <form string="Conversación">
                <header><button name="action_open_chat" type="object" string="Abrir chat" class="btn-primary"/></header>
                <sheet><group><field name="name"/><field name="company_id" readonly="1" groups="base.group_multi_company"/></group></sheet>
            </form>
        </field>
    </record>
    <record id="assistant_conversation_action" model="ir.actions.act_window">
        <field name="name">Conversaciones</field>
        <field name="res_model">assistant.conversation</field>
        <field name="view_mode">list,form</field>
    </record>
    <delete model="ir.ui.menu" id="assistant_conversation_menu"/>
    <delete model="ir.ui.menu" id="assistant_root_menu"/>
</odoo>
